            "max_length": 64,
            "multiline": false,
            "type": "text"
          },
          "label": "Compose project name",
          "required": false
        },
        {
          "description": "Empty: the context set in Settings › Docker, or Docker's current context.",
          "key": "context",
          "kind": {
            "max_length": 128,
            "multiline": false,
            "type": "text"
          },
          "label": "Docker context",
          "required": false
        }
      ],
      "requiresProject": false
    }
  ],
  "manifest": {
    "capabilities": ["profile-read", "machine-resources", "process-execution"],
    "config": [
      {
        "description": "A path to docker, or empty to use docker found on PATH. Only for this computer.",
        "key": "dockerExecutable",
        "kind": {
          "max_length": 1024,
          "multiline": false,
          "type": "text"
        },
        "label": "Docker program",
        "required": false
      },
      {
        "description": "The context commands use, e.g. a remote engine. Empty: Docker's current context. Only for this computer.",
        "key": "context",
        "kind": {
          "max_length": 1024,
          "multiline": false,
          "type": "text"
        },
        "label": "Docker context",
        "required": false
      },
      {
        "default": {
          "type": "boolean",
          "value": false
        },
        "description": "Lets the Compose up, down and restart actions change containers on this computer's Docker context. Off by default; never exported or imported. Down never removes volumes.",
        "key": "allowStateChanges",
        "kind": {
          "type": "boolean"
        },
        "label": "Allow starting and stopping services",
        "required": true
      },
      {
        "default": {
          "type": "text",
          "value": "compose"
        },
        "description": "The project resource with the Compose file or its folder, used when an action names none.",
        "key": "composeRole",
        "kind": {
          "max_length": 1024,
          "multiline": false,
          "type": "text"
        },
        "label": "Compose resource",
        "required": true
      },
      {
        "default": {
          "type": "integer",
          "value": 300
        },
        "key": "timeoutSeconds",
        "kind": {
          "max": 1800,
          "min": 10,
          "type": "integer"
        },
        "label": "Time limit for Compose changes (s)",
        "required": true
      }
    ],
    "dependencies": [],
    "description": "Docker availability, containers, Compose projects and logs, in the Docker context you choose.",
    "enabledByDefault": true,
    "id": "docker",
    "name": "Docker",
    "pages": [],
    "platforms": [],
    "portability": {
      "settings": {
        "allowStateChanges": "machineSpecific",
        "composeRole": "portable",
        "context": "machineSpecific",
        "dockerExecutable": "machineSpecific",
        "timeoutSeconds": "portable"
      },
      "version": 1
    },
    "version": "0.9.0",
    "windows": []
  }
}
