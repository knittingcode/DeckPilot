{
  "actionTypes": [
    {
      "category": "Docker",
      "controls": {
        "key": ["press", "release", "click", "double-click", "long-press"]
      },
      "description": "Whether Docker is installed and its engine reachable in the context, with the client, engine and Compose versions. Succeeds when Docker is unavailable; `available` says so and `reason` why.",
      "id": "docker.status",
      "name": "Docker status",
      "node": {
        "cancellable": true,
        "changesContext": false,
        "effect": "readOnly",
        "icon": "container",
        "idempotent": true,
        "outputs": [
          {
            "always": true,
            "key": "available",
            "kind": "boolean",
            "label": "Available"
          },
          {
            "always": false,
            "key": "reason",
            "kind": "text",
            "label": "Why not available"
          },
          {
            "always": false,
            "key": "clientVersion",
            "kind": "text",
            "label": "Client version"
          },
          {
            "always": false,
            "key": "serverVersion",
            "kind": "text",
            "label": "Engine version"
          },
          {
            "always": false,
            "key": "serverOs",
            "kind": "text",
            "label": "Engine OS"
          },
          {
            "always": false,
            "key": "composeVersion",
            "kind": "text",
            "label": "Compose version"
          },
          {
            "always": false,
            "key": "context",
            "kind": "text",
            "label": "Docker context"
          }
        ],
        "retrySafe": true,
        "timeoutMs": 60000,
        "version": 1
      },
      "parameters": [
        {
          "description": "Empty: the context set in Settings › Docker, or Docker's current context.",
          "key": "context",
          "kind": {
            "max_length": 128,
            "multiline": false,
            "type": "text"
          },
          "label": "Docker context",
          "required": false
        }
      ],
      "requiresProject": false
    },
    {
      "category": "Docker",
      "controls": {
        "key": ["press", "release", "click", "double-click", "long-press"]
      },
      "description": "The containers of the context: names, states, images and status.",
      "id": "docker.containers",
      "name": "Containers",
      "node": {
        "cancellable": true,
        "changesContext": false,
        "effect": "readOnly",
        "icon": "server",
        "idempotent": true,
        "outputs": [
          {
            "always": true,
            "key": "count",
            "kind": "integer",
            "label": "Containers"
          },
          {
            "always": true,
            "key": "running",
            "kind": "integer",
            "label": "Running"
          },
          {
            "always": true,
            "key": "names",
            "kind": "text",
            "label": "Names"
          },
          {
            "always": true,
            "key": "containers",
            "kind": "text",
            "label": "Containers (name, state, image, status)"
          },
          {
            "always": true,
            "key": "context",
            "kind": "text",
            "label": "Docker context"
          }
        ],
        "retrySafe": true,
        "timeoutMs": 30000,
        "version": 1
      },
      "parameters": [
        {
          "default": {
            "type": "boolean",
            "value": false
          },
          "description": "Off: running containers only.",
          "key": "all",
          "kind": {
            "type": "boolean"
          },
          "label": "Include stopped",
          "required": true
        },
        {
          "description": "Only containers whose name contains this.",
          "key": "name",
          "kind": {
            "max_length": 128,
            "multiline": false,
            "type": "text"
          },
          "label": "Name contains",
          "required": false
        },
        {
          "description": "Empty: the context set in Settings › Docker, or Docker's current context.",
          "key": "context",
          "kind": {
            "max_length": 128,
            "multiline": false,
            "type": "text"
          },
          "label": "Docker context",
          "required": false
        }
      ],
      "requiresProject": false
    },
    {
      "category": "Docker",
      "controls": {
        "key": ["press", "release", "click", "double-click", "long-press"]
      },
      "description": "The containers of a Compose project and whether they are running.",
      "id": "docker.compose-status",
      "name": "Compose status",
      "node": {
        "cancellable": true,
        "changesContext": false,
        "effect": "readOnly",
        "icon": "list-checks",
        "idempotent": true,
        "outputs": [
          {
            "always": true,
            "key": "services",
            "kind": "integer",
            "label": "Containers"
          },
          {
            "always": true,
            "key": "running",
            "kind": "integer",
            "label": "Running"
          },
          {
            "always": true,
            "key": "stopped",
            "kind": "integer",
            "label": "Not running"
          },
          {
            "always": true,
            "key": "allRunning",
            "kind": "boolean",
            "label": "All running"
          },
          {
            "always": true,
            "key": "containers",
            "kind": "text",
            "label": "Containers (service, state, image, status)"
          },
          {
            "always": false,
            "key": "project",
            "kind": "text",
            "label": "Compose project"
          },
          {
            "always": false,
            "key": "projectKey",
            "kind": "projectKey",
            "label": "Project"
          },
          {
            "always": true,
            "key": "context",
            "kind": "text",
            "label": "Docker context"
          }
        ],
        "retrySafe": true,
        "timeoutMs": 30000,
        "version": 1
      },
      "parameters": [
        {
          "description": "A resource bound to the Compose file or its folder. Empty: the project's compose resource.",
          "key": "compose",
          "kind": {
            "type": "resource"
          },
          "label": "Compose project",
          "required": false
        },
        {
          "description": "Whose compose resource, when none is set. Empty: the workflow's current project.",
          "key": "project_id",
          "kind": {
            "type": "project"
          },
          "label": "Project",
          "required": false
        },
        {
          "description": "Passed as -p. Empty: Compose's own choice (usually the folder name).",
          "key": "projectName",
          "kind": {
            "max_length": 64,
            "multiline": false,
            "type": "text"
          },
          "label": "Compose project name",
          "required": false
        },
        {
          "description": "Empty: the context set in Settings › Docker, or Docker's current context.",
          "key": "context",
          "kind": {
            "max_length": 128,
            "multiline": false,
            "type": "text"
          },
          "label": "Docker context",
          "required": false
        }
      ],
      "requiresProject": false
    },
    {
      "category": "Docker",
      "controls": {
        "key": ["press", "release", "click", "double-click", "long-press"]
      },
      "description": "Starts a Compose project in the background (up --detach). Must be allowed in Settings › Docker.",
      "id": "docker.compose-up",
      "name": "Compose up",
      "node": {
        "cancellable": true,
        "changesContext": false,
        "effect": "modifies",
        "icon": "play",
        "idempotent": true,
        "outputs": [
          {
            "always": true,
            "key": "output",
            "kind": "text",
            "label": "Compose output",
            "sensitive": true
          },
          {
            "always": false,
            "key": "project",
            "kind": "text",
            "label": "Compose project"
          },
          {
            "always": false,
            "key": "projectKey",
            "kind": "projectKey",
            "label": "Project"
          },
          {
            "always": true,
            "key": "context",
            "kind": "text",
            "label": "Docker context"
          }
        ],
        "retrySafe": true,
        "timeoutMs": 600000,
        "version": 1
      },
      "parameters": [
        {
          "description": "A resource bound to the Compose file or its folder. Empty: the project's compose resource.",
          "key": "compose",
          "kind": {
            "type": "resource"
          },
          "label": "Compose project",
          "required": false
        },
        {
          "description": "Whose compose resource, when none is set. Empty: the workflow's current project.",
          "key": "project_id",
          "kind": {
            "type": "project"
          },
          "label": "Project",
          "required": false
        },
        {
          "description": "Passed as -p. Empty: Compose's own choice (usually the folder name).",
          "key": "projectName",
          "kind": {
            "max_length": 64,
            "multiline": false,
            "type": "text"
          },
          "label": "Compose project name",
          "required": false
        },
        {
          "description": "Empty: the context set in Settings › Docker, or Docker's current context.",
          "key": "context",
          "kind": {
            "max_length": 128,
            "multiline": false,
            "type": "text"
          },
          "label": "Docker context",
          "required": false
        },
        {
          "description": "One per line. Empty: every service of the project.",
          "key": "services",
          "kind": {
            "item_label": "Service",
            "max_items": 50,
            "max_length": 128,
            "type": "lines"
          },
          "label": "Services",
          "required": false
        }
      ],
      "requiresProject": false
    },
    {
      "category": "Docker",
      "controls": {
        "key": ["press", "release", "click", "double-click", "long-press"]
      },
      "description": "Stops and removes a Compose project's containers and networks. Volumes and images are kept. Must be allowed in Settings › Docker.",
      "id": "docker.compose-down",
      "name": "Compose down",
      "node": {
        "cancellable": true,
        "changesContext": false,
        "effect": "modifies",
