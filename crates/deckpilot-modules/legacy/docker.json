    {
      "category": "Docker",
      "controls": {
        "key": ["press", "release", "click", "double-click", "long-press"]
      },
      "description": "The last lines of a container's or Compose service's log, up to 64 KiB. Never follows the log.",
      "id": "docker.logs",
      "name": "Container logs",
      "node": {
        "cancellable": true,
        "changesContext": false,
        "effect": "readOnly",
        "icon": "file-text",
        "idempotent": true,
        "outputs": [
          {
            "always": true,
            "key": "logs",
            "kind": "text",
            "label": "Logs",
            "sensitive": true
          },
          {
            "always": true,
            "key": "lineCount",
            "kind": "integer",
            "label": "Lines"
          },
          {
            "always": true,
            "key": "truncated",
            "kind": "boolean",
            "label": "Truncated"
          },
          {
            "always": true,
            "key": "context",
            "kind": "text",
            "label": "Docker context"
          }
        ],
        "retrySafe": true,
        "timeoutMs": 60000,
        "version": 1
      },
      "parameters": [
        {
          "description": "A container name or id. Or leave it empty and choose a Compose service.",
          "key": "container",
          "kind": {
            "max_length": 128,
            "multiline": false,
            "type": "text"
          },
          "label": "Container",
          "required": false
        },
        {
          "description": "A service of the Compose project below.",
          "key": "service",
          "kind": {
            "max_length": 128,
            "multiline": false,
            "type": "text"
          },
          "label": "Compose service",
          "required": false
        },
        {
          "default": {
            "type": "integer",
            "value": 100
          },
          "description": "The last lines of the log.",
          "key": "lines",
          "kind": {
            "max": 2000,
            "min": 1,
            "type": "integer"
          },
          "label": "Lines",
          "required": true
        },
        {
          "description": "e.g. 10m, 2h or a timestamp. Empty: no limit.",
          "key": "since",
          "kind": {
            "max_length": 40,
            "multiline": false,
            "type": "text"
          },
          "label": "Since",
          "required": false
        },
