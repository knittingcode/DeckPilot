          "description": "A resource bound to the Compose file or its folder. Empty: the project's compose resource.",
          "key": "compose",
          "kind": {
            "type": "resource"
          },
          "label": "Compose project",
          "required": false
        },
        {
          "description": "Whose compose resource, when none is set. Empty: the workflow's current project.",
          "key": "project_id",
          "kind": {
            "type": "project"
          },
          "label": "Project",
          "required": false
        },
        {
          "description": "Passed as -p. Empty: Compose's own choice (usually the folder name).",
          "key": "projectName",
          "kind": {
            "max_length": 64,
            "multiline": false,
            "type": "text"
          },
          "label": "Compose project name",
          "required": false
        },
        {
          "description": "Empty: the context set in Settings › Docker, or Docker's current context.",
          "key": "context",
          "kind": {
            "max_length": 128,
            "multiline": false,
            "type": "text"
          },
          "label": "Docker context",
          "required": false
        },
        {
          "default": {
            "type": "boolean",
            "value": false
          },
          "description": "Also removes containers of services no longer in the Compose file.",
          "key": "removeOrphans",
          "kind": {
            "type": "boolean"
          },
          "label": "Remove orphan containers",
          "required": true
        }
      ],
      "requiresProject": false
    },
    {
      "category": "Docker",
      "controls": {
        "key": ["press", "release", "click", "double-click", "long-press"]
      },
      "description": "Restarts a Compose project's services. Must be allowed in Settings › Docker.",
      "id": "docker.compose-restart",
      "name": "Compose restart",
      "node": {
        "cancellable": true,
        "changesContext": false,
        "effect": "modifies",
        "icon": "refresh-cw",
        "idempotent": false,
        "outputs": [
          {
            "always": true,
            "key": "output",
            "kind": "text",
            "label": "Compose output",
            "sensitive": true
          },
          {
            "always": false,
            "key": "project",
            "kind": "text",
            "label": "Compose project"
          },
          {
            "always": false,
            "key": "projectKey",
            "kind": "projectKey",
            "label": "Project"
          },
          {
            "always": true,
            "key": "context",
            "kind": "text",
            "label": "Docker context"
          }
        ],
        "retrySafe": true,
        "timeoutMs": 600000,
        "version": 1
