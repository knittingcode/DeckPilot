{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knittingcode.github.io/deckpilot-plugins/v1/schemas/plugin-manifest.schema.json",
  "title": "DeckPilot plugin manifest (manifestVersion 1)",
  "description": "Design artifact (docs/marketplace/architecture.md section 7). The file is manifest.json at the plugin root and at the package root. Field shapes for parameters, outputs, node contracts and variable declarations match the JSON the agent already serializes (ParameterSpec, NodeSpec, OutputSpec, VariableDeclaration), with ids relative to the plugin.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "id",
    "name",
    "version",
    "publisher",
    "description",
    "license",
    "engines",
    "entry",
    "icons",
    "permissions",
    "contributes"
  ],
  "properties": {
    "$schema": { "type": "string", "maxLength": 256 },
    "manifestVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/pluginId" },
    "name": { "type": "string", "minLength": 1, "maxLength": 48 },
    "version": { "$ref": "#/$defs/semver" },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/publisherId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "url": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 300 },
    "homepage": { "$ref": "#/$defs/httpsUrl" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": { "const": "git" },
        "url": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^https://github\\.com/[A-Za-z0-9-]{1,39}/[A-Za-z0-9._-]{1,100}$"
        },
        "directory": { "$ref": "#/$defs/relativePath" }
      }
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "SPDX license expression. The package must contain a LICENSE file."
    },
    "keywords": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]{2,24}$" }
    },
    "categories": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "developer-tools",
          "productivity",
          "communication",
          "monitoring",
          "media",
          "smart-home",
          "other"
        ]
      }
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deckpilot", "pluginApi"],
      "properties": {
        "deckpilot": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(>=|>|<=|<|=)?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)( (>=|>|<=|<)(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*))?$",
          "description": "DeckPilot versions the plugin runs on: one or two comparators separated by one space, e.g. \">=0.8.0 <1.0.0\"."
        },
        "pluginApi": {
          "type": "string",
          "pattern": "^\\^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "description": "Plugin API level the bundle needs: same major, at least this minor (e.g. ^1.0)."
        },
        "sdk": {
          "$ref": "#/$defs/semver",
          "description": "Exact @deckpilot/plugin-sdk version used to build. Informational."
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "abi"],
      "properties": {
        "kind": { "const": "wasm" },
        "abi": { "const": 1 }
      },
      "description": "Executable artifact contract (docs/marketplace/artifact-contract.md): a WebAssembly module implementing plugin ABI 1, shipped as plugin.wasm. Omitted means the #191 JavaScript contract (plugin.js), which DeckPilot does not install."
    },
    "entry": {
      "$ref": "#/$defs/relativePath",
      "description": "Source entry module the builder compiles or bundles (e.g. src/lib.rs). The package contains the artifact under a fixed name (plugin.wasm, see runtime); the agent ignores this field."
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["macos", "windows", "linux"] },
      "description": "Omitted means all platforms (ModuleManifest.platforms empty)."
    },
    "icons": {
      "type": "object",
      "additionalProperties": false,
      "required": ["128"],
      "properties": {
        "32": { "$ref": "#/$defs/pngAsset" },
        "128": { "$ref": "#/$defs/pngAsset" },
        "256": { "$ref": "#/$defs/pngAsset" }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keyIcons": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,47}$" },
          "additionalProperties": { "$ref": "#/$defs/pngAsset" }
        },
        "screenshots": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/pngAsset" }
        },
        "readme": { "const": "README.md" },
        "changelog": { "const": "CHANGELOG.md" }
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/permission" }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/dependency" },
      "description": "Plugins (<publisher>.<name>) and built-in modules (one word, e.g. projects) this plugin needs (plugin API 1.4: needs engines.pluginApi ^1.4). Ids are unique and never the plugin's own. A dependency grants nothing: every plugin runs with its own grants only."
    },
    "defaultLocale": {
      "$ref": "#/$defs/localeTag",
      "description": "Plugin API 1.6 (engines.pluginApi ^1.6). The language of the manifest's own texts and the last locale tried before en. Absent: en. Must be one of locales."
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/localeTag" },
      "description": "Plugin API 1.6 (engines.pluginApi ^1.6). The translations the package carries, each as locales/<tag>.json: a JSON object of strings (flat or nested, at most 64 KiB, 1024 keys, 8 levels, 1024 characters per text; {{name}} placeholders; plural suffixes _one, _few, _many, _other; plain text, no HTML tags). The files are package files the manifest names, covered by the package's hashes and signature. With locales, any text the app shows (name, description, publisher.name, action names, descriptions and categories, parameter, output, setting, credential and variable labels and descriptions, errorCodes messages, navigation labels, permission and dependency justifications) may be \"t:<key>\": the key is resolved in the app's language, then its language without the region, then defaultLocale, then en; a key no locale has shows as a label made from its last segment. Ids are never translated. Below 1.6, t:... is plain text."
    },
    "supports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requires": { "$ref": "#/$defs/deviceFamilies" },
            "uses": { "$ref": "#/$defs/deviceFamilies" }
          }
        }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actions": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/action" } },
        "variables": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/variable" } },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "portabilityVersion": { "type": "integer", "minimum": 0, "default": 0 },
            "fields": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/setting" } }
          }
        },
        "credentials": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/credential" }
        },
        "errorCodes": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": { "$ref": "#/$defs/errorCode" },
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "navigation": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/navigationEntry" },
          "description": "Toolbar entries, each opening one of contributes.views (plugin API 1.3: needs engines.pluginApi ^1.3). Ids are unique."
        },
        "views": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/view" },
          "description": "Host-rendered views the navigation entries open (plugin API 1.3). Ids are unique."
        },
        "visualAssets": { "$ref": "#/$defs/visualAssets" },
        "statusItems": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["activeProject"] },
          "description": "Plugin API 1.9 (engines.pluginApi ^1.9), first-party bundled plugins with the hostViews permission only. Status-bar items the app draws from core data; the plugin only names them."
        },
        "dashboardCards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["activeProject"] },
          "description": "Plugin API 1.9 (engines.pluginApi ^1.9), first-party bundled plugins with the hostViews permission only. Dashboard cards the app draws from core data; the plugin only names them."
        }
      }
    }
  },
  "$defs": {
    "localeTag": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$",
      "maxLength": 16,
      "description": "A canonical locale tag: a language (pl), optionally a script (zh-Hant) and a region (pl-PL, es-419)."
    },
    "publisherId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 24,
      "pattern": "^[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*$"
    },
    "pluginName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*$"
    },
    "pluginId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 57,
      "pattern": "^[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*\\.[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*$",
      "description": "<publisher>.<name>. A hyphen is always followed by a letter, so lowerCamel conversion is injective and '--' never occurs."
    },
    "localId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "camelKey": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,31}$" },
    "variablePath": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[a-z][A-Za-z0-9_]{0,31}(\\.[a-z][A-Za-z0-9_]{0,31}){0,2}$",
      "description": "Relative to plugins.<publisherCamel>.<nameCamel> (3 segments), so at most 3 more segments (MAX_ID_SEGMENTS = 6)."
    },
    "errorCode": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(alpha|beta|rc)\\.[1-9][0-9]*)?$",
      "description": "The release-tag grammar DeckPilot uses for itself: no build metadata, pre-release only alpha.N, beta.N or rc.N."
    },
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 512 },
    "relativePath": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*$",
      "not": { "pattern": "(^|/)\\.\\.?(/|$)" }
    },
    "pngAsset": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^assets/[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*\\.png$"
    },
    "justification": { "type": "string", "minLength": 10, "maxLength": 200 },
    "hostPattern": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^(\\*\\.)?([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]([a-z0-9-]{0,61}[a-z0-9])?(:[0-9]{1,5})?$",
      "description": "An exact DNS name with at least two labels, or *.<domain> with at least two labels after '*.'; optional port. No IP literals, no localhost, no bare '*'. Private hosts come only from the user (privateNetwork)."
    },
    "deviceFamilies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["keys", "keyDisplays", "dials", "touchStrip", "brightness"] }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "key": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "enum": ["press", "release", "click", "double-click", "long-press"] }
        },
        "encoder": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "rotate-clockwise",
              "rotate-counter-clockwise",
              "press",
              "release",
              "click",
              "double-click",
              "long-press"
            ]
          }
        },
        "touchZone": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "enum": ["tap", "long-touch", "swipe"] }
        }
      },
      "description": "Per control kind, the inputs the action can be bound to (plugin API 1.3: needs engines.pluginApi ^1.3). A kind that is absent is not supported. Without controls the action works on keys only (press, release, click, double-click, long-press); device.requires never adds a kind."
    },
    "visualAssetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "description": "Local to the plugin; DeckPilot names the asset <plugin id>.<id>. Unique across icons and backgrounds."
    },
    "visualAssets": {
      "type": "object",
      "additionalProperties": false,
      "description": "Icons and backgrounds for DeckPilot's shared Icon and Background Libraries (plugin API 1.8: needs engines.pluginApi ^1.8). Data only: no plugin code runs to list or draw them.",
      "properties": {
        "icons": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "asset"],
            "properties": {
              "id": { "$ref": "#/$defs/visualAssetId" },
              "name": { "type": "string", "minLength": 1, "maxLength": 48 },
              "asset": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^assets/[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*\\.png$",
                "description": "A PNG of the package: at most 256 KiB and 512x512 pixels."
              },
              "keywords": {
                "type": "array",
                "maxItems": 16,
                "items": { "type": "string", "minLength": 1, "maxLength": 32 }
              }
            }
          }
        },
        "backgrounds": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "type"],
            "properties": {
              "id": { "$ref": "#/$defs/visualAssetId" },
              "name": { "type": "string", "minLength": 1, "maxLength": 48 },
              "type": { "enum": ["image", "gradient"] },
              "asset": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^assets/[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*\\.(png|jpg|jpeg)$",
                "description": "type image: a PNG or JPEG of the package, at most 1 MiB and 1024x1024 pixels."
              },
              "colors": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
              },
              "angle": { "type": "integer", "minimum": 0, "maximum": 359 }
            },
            "oneOf": [
              {
                "properties": { "type": { "const": "image" } },
                "required": ["asset"],
                "not": { "anyOf": [{ "required": ["colors"] }, { "required": ["angle"] }] }
              },
              {
                "properties": { "type": { "const": "gradient" } },
                "required": ["colors"],
                "not": { "required": ["asset"] }
              }
            ]
          }
        }
      }
    },
    "navigationIconPath": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^assets/[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*\\.(png|webp|svg)$",
      "description": "A package file: PNG or WebP of at most 256 KiB and 512x512 pixels, or SVG of at most 64 KiB without scripts, event handlers, foreignObject, external or data: links, style url()/@import, DOCTYPE or entities."
    },
    "navigationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "icon", "view"],
      "properties": {
        "id": { "$ref": "#/$defs/navigationId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 24 },
        "icon": {
          "oneOf": [
            { "$ref": "#/$defs/navigationIconPath" },
            {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "light": { "$ref": "#/$defs/navigationIconPath" },
                "dark": { "$ref": "#/$defs/navigationIconPath" }
              }
            }
          ]
        },
        "view": {
          "$ref": "#/$defs/navigationId",
          "description": "The id of one of contributes.views."
        }
      }
    },
    "navigationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/navigationId" },
        "kind": {
          "enum": ["variables", "actions", "settings", "workflows", "projects"],
          "description": "variables: the plugin's variables, live; actions: the Action Library filtered to the plugin; settings: the plugin's configuration page; workflows and projects (plugin API 1.9, first-party bundled plugins with the hostViews permission only): the app's own Workflows and Projects screens, which the plugin activates."
        },
        "context": {
          "enum": ["none", "device", "profile", "device+profile"],
          "description": "Plugin API 1.4 (engines.pluginApi ^1.4). Which of the app's toolbar selectors the view shows: the device, the profile being edited, both or neither (the default when absent). It changes only the app's chrome: it gives the plugin no device or profile data and grants no permission."
        }
      }
    },
    "permission": {
      "type": "object",
      "required": ["kind", "justification"],
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "network" },
            "hosts": {
              "type": "array",
              "minItems": 0,
              "maxItems": 16,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/hostPattern" },
              "description": "At least one host, unless userOrigins names a slot."
            },
            "methods": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"] }
            },
            "privateNetwork": { "type": "boolean", "default": false },
            "userOrigins": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": { "$ref": "#/$defs/userOriginSlot" },
              "description": "Origins the user enters in a text setting (a GitHub Enterprise server, a self-managed GitLab, a Jira site). Never granted at install: the user consents to the exact origin when they save it."
            },
            "justification": { "$ref": "#/$defs/justification" }
          },
          "required": ["hosts"],
          "anyOf": [
            { "properties": { "hosts": { "minItems": 1 } } },
            { "required": ["userOrigins"] }
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "credentials" },
            "refs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/camelKey" }
            },
            "justification": { "$ref": "#/$defs/justification" }
          },
          "required": ["refs"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "notifications" },
            "routing": {
              "description": "Where the notifications go, as the user sets it in the plugin's settings: each member names one of contributes.settings, which the agent reads when it shows a notification. Without it: the status bar only.",
              "type": "object",
              "minProperties": 1,
              "properties": {
                "desktop": { "$ref": "#/$defs/camelKey" },
                "statusBar": { "$ref": "#/$defs/camelKey" },
                "minimumSeverity": { "$ref": "#/$defs/camelKey" }
              },
              "additionalProperties": false
            },
            "justification": { "$ref": "#/$defs/justification" }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "profile" },
            "read": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["profile", "project"] }
            },
            "justification": { "$ref": "#/$defs/justification" }
          },
          "required": ["read"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "variables" },
            "read": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 200,
                "pattern": "^[a-z][A-Za-z0-9_]{0,31}(\\.[a-z][A-Za-z0-9_]{0,31}){1,5}(\\.\\*)?$"
              }
            },
            "justification": { "$ref": "#/$defs/justification" }
          },
          "required": ["read"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "storage" },
            "quotaKb": { "type": "integer", "minimum": 257, "maximum": 10240 },
            "justification": { "$ref": "#/$defs/justification" }
          },
          "required": ["quotaKb"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "openUrl" },
            "hosts": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/hostPattern" }
            },
            "userOrigins": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/camelKey" },
              "description": "Settings of the network permission's user-origin slots: pages on the server the user entered there, and allowed, may be opened too. Never granted at install: it follows the user's consent to that exact server."
            },
            "fromParams": {
              "type": "boolean",
              "description": "Plugin API 1.9 (engines.pluginApi ^1.9), first-party bundled plugins only. The agent may open the literal http or https URL the user stored in one of the invocation's own parameters (url.openParam); the plugin never names the URL. Medium tier."
            },
            "justification": { "$ref": "#/$defs/justification" }
          },
          "required": ["hosts"],
          "anyOf": [
            { "properties": { "hosts": { "minItems": 1 } } },
            { "required": ["userOrigins"] },
            { "required": ["fromParams"], "properties": { "fromParams": { "const": true } } }
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "background" },
            "minIntervalSeconds": { "type": "integer", "minimum": 15, "maximum": 86400 },
            "justification": { "$ref": "#/$defs/justification" }
          },
          "required": ["minIntervalSeconds"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "device" },
            "state": { "type": "boolean" },
            "icons": { "type": "boolean" },
            "justification": { "$ref": "#/$defs/justification" }
          },
          "additionalProperties": false
        },
        {
          "description": "Plugin API 1.5 (engines.pluginApi ^1.5). Standard dialogs DeckPilot draws for the plugin (dialog.open: confirm, alert, form, selection), titled with the plugin's name, only in actions the user started. Medium tier. Declarative data only: no plugin UI code and no secret fields.",
          "properties": {
            "kind": { "const": "dialogs" },
            "justification": { "$ref": "#/$defs/justification" }
          },
          "additionalProperties": false
        },
        {
          "description": "Plugin API 1.9 (engines.pluginApi ^1.9), first-party bundled plugins only. Brokered runs of the user's own git or docker: argument arrays (never a shell string) limited to the declared subcommands and options of the host's policy, in a resource handle's directory. High tier, explicit consent per tool and sub-grant (tools:git, tools:git:network, tools:docker, tools:docker:modify). A plugin with tools declares no network, credentials or openUrl.",
          "properties": {
            "kind": { "const": "tools" },
            "tools": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": { "$ref": "#/$defs/toolDeclaration" }
            },
            "justification": { "$ref": "#/$defs/justification" }
          },
          "required": ["tools"],
          "additionalProperties": false
        },
        {
          "description": "Plugin API 1.9 (engines.pluginApi ^1.9), first-party bundled plugins only. resource.resolve of the active project's roles (medium), with the bound path (paths, medium), and resource.open of a bound location in a bound application (open, high, only in runs the user started).",
          "properties": {
            "kind": { "const": "resources" },
            "paths": { "type": "boolean" },
            "open": { "type": "boolean" },
            "justification": { "$ref": "#/$defs/justification" }
          },
          "additionalProperties": false
        },
        {
          "description": "Plugin API 1.9 (engines.pluginApi ^1.9), first-party bundled plugins only. Reading the active profile's projects and the active project (medium); with select, switching it (high, only in runs the user started).",
          "properties": {
            "kind": { "const": "projectContext" },
            "select": { "type": "boolean" },
            "justification": { "$ref": "#/$defs/justification" }
          },
          "additionalProperties": false
        },
        {
          "description": "Plugin API 1.9 (engines.pluginApi ^1.9), first-party bundled plugins only. The app's own workflows and projects views, statusItems and dashboardCards, drawn by the host from core data. Placement only, no data. Low tier.",
          "properties": {
            "kind": { "const": "hostViews" },
            "justification": { "$ref": "#/$defs/justification" }
          },
          "additionalProperties": false
        }
      ]
    },
    "toolDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "subcommands"],
      "properties": {
        "executable": {
          "enum": ["git", "docker"],
          "description": "The only executables. The path is the user's own host-held setting, never the plugin's."
        },
        "subcommands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "description": "A subcommand of the host's policy: git status, log, config, remote, rev-parse, ls-remote; docker context show, version, compose version, ps, compose ps, compose logs, logs, compose up, compose down, compose restart, start, stop, restart."
              },
              "options": {
                "type": "array",
                "maxItems": 16,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 32 },
                "description": "Options of the host's policy for that subcommand: exact tokens (-z) or names of options whose value the host checks (--format)."
              }
            }
          }
        },
        "network": {
          "type": "boolean",
          "description": "git only: ls-remote, with the user's SSH identity (tools:git:network)."
        },
        "modify": {
          "type": "boolean",
          "description": "docker only: start, stop and restart containers and compose services (tools:docker:modify, off by default)."
        }
      }
    },
    "parameterKind": {
      "type": "object",
      "required": ["type"],
      "description": "ParameterKind as the agent serializes it, minus credential (not available to plugins). resource is plugin API 1.9 and first-party bundled plugins only.",
      "oneOf": [
        {
          "properties": {
            "type": { "const": "text" },
            "multiline": { "type": "boolean" },
            "maxLength": { "type": "integer", "minimum": 1, "maximum": 100000 }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "integer" },
            "min": { "type": "integer" },
            "max": { "type": "integer" }
          },
          "additionalProperties": false
        },
        { "properties": { "type": { "const": "boolean" } }, "additionalProperties": false },
        {
          "properties": {
            "type": { "const": "choice" },
            "options": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 64 }
            }
          },
          "required": ["options"],
          "additionalProperties": false
        },
        { "properties": { "type": { "const": "project" } }, "additionalProperties": false },
        {
          "description": "Plugin API 1.9 (engines.pluginApi ^1.9), first-party bundled plugins only. A machine resource of one of the kinds, fixed or a role of the active project; the plugin receives an opaque handle with the binding's label, never the path. Not for settings.",
          "properties": {
            "type": { "const": "resource" },
            "kinds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": { "enum": ["directory", "file", "application", "dockerEnvironment"] }
            }
          },
          "required": ["kinds"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "lines" },
            "itemLabel": { "type": "string", "maxLength": 32 },
            "maxItems": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "maxLength": { "type": "integer", "minimum": 1, "maximum": 10000 }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "pairs" },
            "separator": { "enum": ["=", ":"] },
            "nameLabel": { "type": "string", "maxLength": 32 },
            "valueLabel": { "type": "string", "maxLength": 32 },
            "maxItems": { "type": "integer", "minimum": 1, "maximum": 200 },
            "caseInsensitive": { "type": "boolean" },
            "noSecrets": { "type": "boolean" }
          },
          "required": ["separator"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "code" },
            "language": { "enum": ["json", "text", "yaml", "markdown"] },
            "maxLength": { "type": "integer", "minimum": 1, "maximum": 100000 }
          },
          "required": ["language"],
          "additionalProperties": false
        }
      ]
    },
    "parameterValue": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "description": "A literal ParameterValue. References and templates are never defaults.",
      "properties": {
        "type": { "enum": ["text", "integer", "boolean", "choice"] },
        "value": true
      },
      "oneOf": [
        { "properties": { "type": { "const": "text" }, "value": { "type": "string" } } },
        { "properties": { "type": { "const": "integer" }, "value": { "type": "integer" } } },
        { "properties": { "type": { "const": "boolean" }, "value": { "type": "boolean" } } },
        { "properties": { "type": { "const": "choice" }, "value": { "type": "string" } } }
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "kind", "required"],
      "properties": {
        "key": { "$ref": "#/$defs/camelKey" },
        "label": { "type": "string", "minLength": 1, "maxLength": 48 },
        "description": { "type": "string", "maxLength": 300 },
        "kind": { "$ref": "#/$defs/parameterKind" },
        "required": { "type": "boolean" },
        "default": { "$ref": "#/$defs/parameterValue" }
      }
    },
    "setting": {
      "type": "object",
      "required": ["key", "label", "kind", "required"],
      "properties": {
        "key": { "$ref": "#/$defs/camelKey" },
        "label": { "type": "string", "minLength": 1, "maxLength": 48 },
        "description": { "type": "string", "maxLength": 300 },
        "kind": { "$ref": "#/$defs/parameterKind" },
        "required": { "type": "boolean" },
        "default": { "$ref": "#/$defs/parameterValue" },
        "portability": {
          "enum": ["portable", "machineSpecific", "sensitive"],
          "default": "machineSpecific"
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label"],
      "properties": {
        "key": { "$ref": "#/$defs/camelKey" },
        "label": { "type": "string", "minLength": 1, "maxLength": 48 },
        "kind": {
          "enum": ["text", "integer", "boolean", "path", "url", "projectKey"],
          "default": "text"
        },
        "always": { "type": "boolean", "default": false },
        "sensitive": { "type": "boolean", "default": false }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "description": "NodeSpec. changesContext (plugin API 1.9) needs the projectContext permission with select: first-party bundled plugins only.",
      "properties": {
        "version": { "type": "integer", "minimum": 1, "default": 1 },
        "icon": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
        "outputs": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/output" } },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 600000, "default": 30000 },
        "retrySafe": { "type": "boolean", "default": false },
        "idempotent": { "type": "boolean", "default": false },
        "cancellable": { "type": "boolean", "default": false },
        "effect": { "enum": ["readOnly", "opens", "modifies"], "default": "readOnly" },
        "changesContext": { "type": "boolean", "default": false }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "category", "parameters"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 48 },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "category": { "type": "string", "minLength": 1, "maxLength": 32 },
        "parameters": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/parameter" }
        },
        "requiresProject": { "type": "boolean", "default": false },
        "deprecated": { "type": "boolean", "default": false },
        "replacedBy": { "$ref": "#/$defs/localId" },
        "node": { "$ref": "#/$defs/node" },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["refresh", "intervalSeconds"],
          "properties": {
            "refresh": { "enum": ["onEvents", "every"] },
            "intervalSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
          }
        },
        "device": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "requires": { "$ref": "#/$defs/deviceFamilies" } }
        },
        "controls": { "$ref": "#/$defs/controls" },
        "requiresDependencies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dependencyId" },
          "description": "Ids of declared dependencies (usually optional ones) this action needs; while one is missing or disabled only this action is unavailable (plugin API 1.4)."
        },
        "requiresPermissions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "tools:git:network",
              "tools:docker:modify",
              "resources:open",
              "resources:paths",
              "projectContext:select",
              "openUrl:from-params"
            ]
          },
          "description": "Plugin API 1.9: declared sub-grants this action needs. Each one named here is optional: the plugin is enabled without it, and while it is not granted only the actions naming it are unavailable. A high-tier one is off until the user grants it."
        },
        "title": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default": { "type": "string", "minLength": 1, "maxLength": 32 },
            "dynamic": { "type": "boolean" },
            "position": { "enum": ["top", "middle", "bottom"] },
            "supports": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["visibility", "position", "font", "style", "color", "layout"] }
            }
          },
          "description": "What the action suggests for its keys' titles (plugin API 1.8): a default title, whether it sets the title while it runs (its state's label), a position, and the parts of the look DeckPilot's title editor offers. Suggestions only: the user's own title and look always win; the editor cannot be replaced."
        },
        "editorNavigation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation"],
          "properties": {
            "operation": {
              "enum": [
                "folder.open",
                "folder.back",
                "page.next",
                "page.previous",
                "layout.switch",
                "layout.back"
              ]
            },
            "targetParameter": { "type": "string", "minLength": 1, "maxLength": 32 },
            "pageParameter": { "type": "string", "minLength": 1, "maxLength": 32 }
          },
          "description": "What running the action does to the page or layout a device shows, for the editor's interactive preview (plugin API 1.7). Data only: the editor moves its own view and never calls the plugin. folder.open and layout.switch name the text parameter that holds the target (a page id, a layout id); layout.switch may also name its pageParameter."
        }
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "valueType", "scope"],
      "properties": {
        "id": { "$ref": "#/$defs/variablePath" },
        "name": { "type": "string", "minLength": 1, "maxLength": 48 },
        "description": { "type": "string", "maxLength": 300 },
        "valueType": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "enum": ["string", "integer", "boolean", "json"] } }
        },
        "scope": { "enum": ["machine", "profile", "project"] },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": { "const": "project" }
        },
        "sensitive": { "type": "boolean", "default": false },
        "deprecated": { "type": "boolean", "default": false },
        "source": {
          "enum": ["host:project.id", "host:project.key", "host:project.name"],
          "description": "Plugin API 1.9, first-party bundled plugins with the projectContext permission only: DeckPilot computes and publishes the value (the id, key or name of the project in the context; scope project, a string). The plugin never publishes it."
        }
      }
    },
    "userOriginSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setting"],
      "properties": {
        "setting": {
          "$ref": "#/$defs/camelKey",
          "description": "The key of a one-line text setting the user enters the origin into."
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"] },
          "description": "A subset of the permission's methods; absent means all of them."
        },
        "pathPrefix": {
          "type": "boolean",
          "default": false,
          "description": "The user may enter a path with the origin (https://ghe.example.com/api/v3); requests are limited to it."
        },
        "privateNetwork": {
          "type": "boolean",
          "default": false,
          "description": "The user may enter a server on a private network; each such origin needs its own explicit consent. Loopback and link-local addresses are never reachable."
        }
      }
    },
    "dependencyId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 57,
      "pattern": "^[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*(\\.[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*)?$",
      "description": "A plugin id (<publisher>.<name>) or the id of a built-in module (one lowercase word, e.g. projects)."
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/dependencyId" },
        "version": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(>=|>|<=|<|=)?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)( (>=|>|<=|<)(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*))?$",
          "description": "Versions this plugin works with, in the grammar of engines.deckpilot, e.g. \">=1.2.0 <2.0.0\". For a built-in module, DeckPilot's version."
        },
        "optional": {
          "type": "boolean",
          "default": false,
          "description": "An optional integration: never installed by itself; only the actions naming it in requiresDependencies need it."
        },
        "justification": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "hosts", "schemes"],
      "anyOf": [{ "properties": { "hosts": { "minItems": 1 } } }, { "required": ["userOrigin"] }],
      "properties": {
        "key": { "$ref": "#/$defs/camelKey" },
        "label": { "type": "string", "minLength": 1, "maxLength": 48 },
        "description": { "type": "string", "maxLength": 300 },
        "hosts": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/hostPattern" },
          "description": "Subset of the network permission's hosts. The secret is sent nowhere else (besides the user origin). At least one host, unless userOrigin is set."
        },
        "userOrigin": {
          "$ref": "#/$defs/camelKey",
          "description": "The setting of a network.userOrigins slot: the secret is also sent to the origin the user entered there, once they consented to it."
        },
        "schemes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["bearer", "basic", "header", "query"] }
        },
        "headerName": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,64}$" },
        "queryName": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
        "setupUrl": { "$ref": "#/$defs/httpsUrl" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "schemes": { "type": "array", "contains": { "const": "header" } } }
          },
          "then": { "required": ["headerName"] }
        },
        {
          "if": {
            "properties": { "schemes": { "type": "array", "contains": { "const": "query" } } }
          },
          "then": { "required": ["queryName"] }
        }
      ]
    }
  }
}
