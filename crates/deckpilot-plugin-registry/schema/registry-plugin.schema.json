{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knittingcode.github.io/deckpilot-plugins/v1/schemas/registry-plugin.schema.json",
  "title": "DeckPilot plugin registry: plugins/<id>/<sha256>.json",
  "description": "Design artifact (docs/marketplace/architecture.md section 10). Per-plugin detail with every published version. Content-addressed and pinned by the signed index; at most 256 KiB. The registry submission file registry/plugins/<id>/versions/<version>.json uses $defs/version without published_at, package.url, attestation and yanked, which the pipeline adds.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_type",
    "spec_version",
    "id",
    "publisher",
    "name",
    "description",
    "license",
    "versions"
  ],
  "properties": {
    "_type": { "const": "deckpilot-registry-plugin" },
    "spec_version": { "const": 1 },
    "id": { "$ref": "#/$defs/pluginId" },
    "publisher": {
      "$ref": "https://knittingcode.github.io/deckpilot-plugins/v1/schemas/plugin-manifest.schema.json#/$defs/publisherId"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 48 },
    "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "license": { "type": "string", "minLength": 1, "maxLength": 64 },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 512 },
    "source_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]{1,39}/[A-Za-z0-9._-]{1,100}$"
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/version" }
    }
  },
  "$defs": {
    "pluginId": {
      "$ref": "https://knittingcode.github.io/deckpilot-plugins/v1/schemas/plugin-manifest.schema.json#/$defs/pluginId"
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "published_at",
        "engines",
        "permissions",
        "manifest_sha256",
        "source",
        "package",
        "builder"
      ],
      "properties": {
        "version": {
          "$ref": "https://knittingcode.github.io/deckpilot-plugins/v1/schemas/plugin-manifest.schema.json#/$defs/semver"
        },
        "published_at": { "type": "string", "format": "date-time" },
        "engines": {
          "$ref": "https://knittingcode.github.io/deckpilot-plugins/v1/schemas/plugin-manifest.schema.json#/properties/engines"
        },
        "platforms": {
          "$ref": "https://knittingcode.github.io/deckpilot-plugins/v1/schemas/plugin-manifest.schema.json#/properties/platforms"
        },
        "permissions": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "https://knittingcode.github.io/deckpilot-plugins/v1/schemas/plugin-manifest.schema.json#/$defs/permission"
          },
          "description": "Byte-for-byte the manifest's permissions array, shown in the consent dialog before download. The installer refuses a package whose manifest differs."
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of manifest.json inside the package."
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "commit"],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{1,39}/[A-Za-z0-9._-]{1,100}$"
            },
            "tag": { "type": "string", "minLength": 1, "maxLength": 128 },
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "path": {
              "$ref": "https://knittingcode.github.io/deckpilot-plugins/v1/schemas/plugin-manifest.schema.json#/$defs/relativePath"
            },
            "archive": {
              "type": "string",
              "pattern": "^https://github\\.com/knittingcode/deckpilot-plugins/releases/download/[a-z][a-z0-9.-]{3,56}--v[0-9a-z.-]{5,32}/[a-z0-9.-]+\\.source\\.tar\\.gz$"
            }
          }
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "sha256", "size"],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://github\\.com/knittingcode/deckpilot-plugins/releases/download/[a-z][a-z0-9.-]{3,56}--v[0-9a-z.-]{5,32}/[a-z0-9.-]+\\.dpplugin$"
            },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "size": { "type": "integer", "minimum": 1, "maximum": 5242880 }
          }
        },
        "builder": {
          "$ref": "https://knittingcode.github.io/deckpilot-plugins/v1/schemas/plugin-manifest.schema.json#/$defs/semver",
          "description": "@deckpilot/plugin-builder version that produced the package."
        },
        "attestation": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "Informational link to the build provenance attestation. Clients do not verify it in v1."
        },
        "yanked": {
          "type": "object",
          "additionalProperties": false,
          "required": ["at", "reason"],
          "properties": {
            "at": { "type": "string", "format": "date-time" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        }
      }
    }
  }
}
