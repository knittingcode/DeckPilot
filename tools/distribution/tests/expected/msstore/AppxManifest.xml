<?xml version="1.0" encoding="utf-8"?>
<!-- DRAFT MSIX manifest for a Microsoft Store build (targets.toml
     microsoft-store-msix). Not built. The Identity Name and Publisher are
     assigned by Partner Center (no account exists); 0.6.0.0 is filled in
     by tools/distribution/generate.py msstore. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop rescap">
  <Identity Name="PARTNER_CENTER_IDENTITY_NAME" Publisher="CN=PARTNER_CENTER_PUBLISHER" Version="0.6.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>DeckPilot</DisplayName>
    <PublisherDisplayName>knittingcode</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="DeckPilot" Executable="deckpilot-desktop.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="DeckPilot" Description="Stream Deck management"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Autostart of the agent: HKCU Run writes are virtualized in a
             package (capability matrix 2.3); the user can turn it off in
             Settings. -->
        <uap5:Extension Category="windows.startupTask" Executable="deckpilot-agent.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="DeckPilotAgent" Enabled="false" DisplayName="DeckPilot Agent" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
