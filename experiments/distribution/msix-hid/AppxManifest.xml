<?xml version="1.0" encoding="utf-8"?>
<!-- A throwaway full-trust MSIX package for the HID probe. The publisher is
     the subject of a self-signed certificate run.ps1 creates on the runner
     and discards; nothing here is a Partner Center identity. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">
  <Identity Name="DeckPilotExperiment.MsixHid" Publisher="CN=DeckPilot MSIX experiment" Version="0.0.1.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>DeckPilot MSIX HID probe</DisplayName>
    <PublisherDisplayName>DeckPilot experiment</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="Probe" Executable="msix-hid.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="DeckPilot MSIX HID probe" Description="HID enumeration probe"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" AppListEntry="none" />
      <Extensions>
        <!-- Starts the packaged executable, with package identity, from a console. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="msix-hid.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="deckpilot-msix-hid.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
