<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What a Mac App Store agent would carry for the device: App Sandbox plus
     the USB device entitlement. Apple documents no HID-specific App
     Sandbox entitlement: com.apple.developer.hid.virtual.device is for
     virtual devices and the DriverKit HID entitlements are for driver
     extensions; neither applies to hidapi. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.device.usb</key>
	<true/>
</dict>
</plist>
