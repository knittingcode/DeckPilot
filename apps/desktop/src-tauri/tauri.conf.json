{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeckPilot",
  "version": "0.6.0-alpha.2",
  "identifier": "io.github.knittingcode.deckpilot",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "visible": false,
        "title": "DeckPilot",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 26 },
        "width": 1120,
        "height": 740,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "Apache-2.0",
    "category": "Utility",
    "shortDescription": "Stream Deck management",
    "macOS": {
      "hardenedRuntime": true
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/70-deckpilot-streamdeck.rules": "../../../packaging/linux/70-deckpilot-streamdeck.rules"
        }
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/70-deckpilot-streamdeck.rules": "../../../packaging/linux/70-deckpilot-streamdeck.rules"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/knittingcode/DeckPilot/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
