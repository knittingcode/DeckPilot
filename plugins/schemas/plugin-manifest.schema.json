{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knittingcode.github.io/deckpilot-plugins/v1/schemas/plugin-manifest.schema.json",
  "title": "DeckPilot plugin manifest (manifestVersion 1)",
  "description": "Design artifact (docs/marketplace/architecture.md section 7). The file is manifest.json at the plugin root and at the package root. Field shapes for parameters, outputs, node contracts and variable declarations match the JSON the agent already serializes (ParameterSpec, NodeSpec, OutputSpec, VariableDeclaration), with ids relative to the plugin.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "id",
    "name",
    "version",
    "publisher",
    "description",
    "license",
    "engines",
    "entry",
    "icons",
    "permissions",
    "contributes"
  ],
  "properties": {
    "$schema": { "type": "string", "maxLength": 256 },
    "manifestVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/pluginId" },
    "name": { "type": "string", "minLength": 1, "maxLength": 48 },
    "version": { "$ref": "#/$defs/semver" },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/publisherId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "url": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 300 },
    "homepage": { "$ref": "#/$defs/httpsUrl" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": { "const": "git" },
        "url": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^https://github\\.com/[A-Za-z0-9-]{1,39}/[A-Za-z0-9._-]{1,100}$"
        },
        "directory": { "$ref": "#/$defs/relativePath" }
      }
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "SPDX license expression. The package must contain a LICENSE file."
    },
    "keywords": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]{2,24}$" }
    },
    "categories": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "developer-tools",
          "productivity",
          "communication",
          "monitoring",
          "media",
          "smart-home",
          "other"
        ]
      }
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deckpilot", "pluginApi"],
      "properties": {
        "deckpilot": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(>=|>|<=|<|=)?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)( (>=|>|<=|<)(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*))?$",
          "description": "DeckPilot versions the plugin runs on: one or two comparators separated by one space, e.g. \">=0.8.0 <1.0.0\"."
        },
        "pluginApi": {
          "type": "string",
          "pattern": "^\\^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "description": "Plugin API level the bundle needs: same major, at least this minor (e.g. ^1.0)."
        },
        "sdk": {
          "$ref": "#/$defs/semver",
          "description": "Exact @deckpilot/plugin-sdk version used to build. Informational."
        }
      }
    },
    "entry": {
      "$ref": "#/$defs/relativePath",
      "description": "Source entry module the builder bundles (e.g. src/index.ts). The package always contains the bundle as plugin.js; the agent ignores this field."
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["macos", "windows", "linux"] },
      "description": "Omitted means all platforms (ModuleManifest.platforms empty)."
    },
    "icons": {
      "type": "object",
      "additionalProperties": false,
      "required": ["128"],
      "properties": {
        "32": { "$ref": "#/$defs/pngAsset" },
        "128": { "$ref": "#/$defs/pngAsset" },
        "256": { "$ref": "#/$defs/pngAsset" }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keyIcons": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,47}$" },
          "additionalProperties": { "$ref": "#/$defs/pngAsset" }
        },
        "screenshots": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/pngAsset" }
        },
        "readme": { "const": "README.md" },
        "changelog": { "const": "CHANGELOG.md" }
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/permission" }
    },
    "supports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requires": { "$ref": "#/$defs/deviceFamilies" },
            "uses": { "$ref": "#/$defs/deviceFamilies" }
          }
        }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actions": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/action" } },
        "variables": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/variable" } },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "portabilityVersion": { "type": "integer", "minimum": 0, "default": 0 },
            "fields": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/setting" } }
          }
        },
        "credentials": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/credential" }
        },
        "errorCodes": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": { "$ref": "#/$defs/errorCode" },
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    }
  },
  "$defs": {
    "publisherId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 24,
      "pattern": "^[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*$"
    },
    "pluginName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*$"
    },
    "pluginId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 57,
      "pattern": "^[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*\\.[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*$",
      "description": "<publisher>.<name>. A hyphen is always followed by a letter, so lowerCamel conversion is injective and '--' never occurs."
    },
    "localId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "camelKey": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,31}$" },
    "variablePath": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[a-z][A-Za-z0-9_]{0,31}(\\.[a-z][A-Za-z0-9_]{0,31}){0,2}$",
      "description": "Relative to plugins.<publisherCamel>.<nameCamel> (3 segments), so at most 3 more segments (MAX_ID_SEGMENTS = 6)."
    },
    "errorCode": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(alpha|beta|rc)\\.[1-9][0-9]*)?$",
      "description": "The release-tag grammar DeckPilot uses for itself: no build metadata, pre-release only alpha.N, beta.N or rc.N."
    },
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 512 },
    "relativePath": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*$",
      "not": { "pattern": "(^|/)\\.\\.?(/|$)" }
    },
    "pngAsset": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^assets/[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*\\.png$"
    },
    "justification": { "type": "string", "minLength": 10, "maxLength": 200 },
    "hostPattern": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^(\\*\\.)?([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]([a-z0-9-]{0,61}[a-z0-9])?(:[0-9]{1,5})?$",
      "description": "An exact DNS name with at least two labels, or *.<domain> with at least two labels after '*.'; optional port. No IP literals, no localhost, no bare '*'. Private hosts come only from the user (privateNetwork)."
    },
    "deviceFamilies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["keys", "keyDisplays", "dials", "touchStrip", "brightness"] }
    },
    "permission": {
      "type": "object",
      "required": ["kind", "justification"],
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "network" },
            "hosts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/hostPattern" }
            },
            "methods": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"] }
            },
            "privateNetwork": { "type": "boolean", "default": false },
            "justification": { "$ref": "#/$defs/justification" }
          },
          "required": ["hosts"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "credentials" },
            "refs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/camelKey" }
            },
            "justification": { "$ref": "#/$defs/justification" }
          },
          "required": ["refs"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "notifications" },
            "justification": { "$ref": "#/$defs/justification" }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "profile" },
            "read": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["profile", "project"] }
            },
            "justification": { "$ref": "#/$defs/justification" }
          },
          "required": ["read"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "variables" },
            "read": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 200,
                "pattern": "^[a-z][A-Za-z0-9_]{0,31}(\\.[a-z][A-Za-z0-9_]{0,31}){1,5}(\\.\\*)?$"
              }
            },
            "justification": { "$ref": "#/$defs/justification" }
          },
          "required": ["read"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "storage" },
            "quotaKb": { "type": "integer", "minimum": 257, "maximum": 10240 },
            "justification": { "$ref": "#/$defs/justification" }
          },
          "required": ["quotaKb"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "openUrl" },
            "hosts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/hostPattern" }
            },
            "justification": { "$ref": "#/$defs/justification" }
          },
          "required": ["hosts"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "background" },
            "minIntervalSeconds": { "type": "integer", "minimum": 15, "maximum": 86400 },
            "justification": { "$ref": "#/$defs/justification" }
          },
          "required": ["minIntervalSeconds"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "device" },
            "state": { "type": "boolean" },
            "icons": { "type": "boolean" },
            "justification": { "$ref": "#/$defs/justification" }
          },
          "additionalProperties": false
        }
      ]
    },
    "parameterKind": {
      "type": "object",
      "required": ["type"],
      "description": "ParameterKind as the agent serializes it, minus resource and credential (not available to plugins in API 1).",
      "oneOf": [
        {
          "properties": {
            "type": { "const": "text" },
            "multiline": { "type": "boolean" },
            "maxLength": { "type": "integer", "minimum": 1, "maximum": 100000 }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "integer" },
            "min": { "type": "integer" },
            "max": { "type": "integer" }
          },
          "additionalProperties": false
        },
        { "properties": { "type": { "const": "boolean" } }, "additionalProperties": false },
        {
          "properties": {
            "type": { "const": "choice" },
            "options": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 64 }
            }
          },
          "required": ["options"],
          "additionalProperties": false
        },
        { "properties": { "type": { "const": "project" } }, "additionalProperties": false },
        {
          "properties": {
            "type": { "const": "lines" },
            "itemLabel": { "type": "string", "maxLength": 32 },
            "maxItems": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "maxLength": { "type": "integer", "minimum": 1, "maximum": 10000 }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "pairs" },
            "separator": { "enum": ["=", ":"] },
            "nameLabel": { "type": "string", "maxLength": 32 },
            "valueLabel": { "type": "string", "maxLength": 32 },
            "maxItems": { "type": "integer", "minimum": 1, "maximum": 200 },
            "caseInsensitive": { "type": "boolean" },
            "noSecrets": { "type": "boolean" }
          },
          "required": ["separator"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "code" },
            "language": { "enum": ["json", "text", "yaml", "markdown"] },
            "maxLength": { "type": "integer", "minimum": 1, "maximum": 100000 }
          },
          "required": ["language"],
          "additionalProperties": false
        }
      ]
    },
    "parameterValue": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "description": "A literal ParameterValue. References and templates are never defaults.",
      "properties": {
        "type": { "enum": ["text", "integer", "boolean", "choice"] },
        "value": true
      },
      "oneOf": [
        { "properties": { "type": { "const": "text" }, "value": { "type": "string" } } },
        { "properties": { "type": { "const": "integer" }, "value": { "type": "integer" } } },
        { "properties": { "type": { "const": "boolean" }, "value": { "type": "boolean" } } },
        { "properties": { "type": { "const": "choice" }, "value": { "type": "string" } } }
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "kind", "required"],
      "properties": {
        "key": { "$ref": "#/$defs/camelKey" },
        "label": { "type": "string", "minLength": 1, "maxLength": 48 },
        "description": { "type": "string", "maxLength": 300 },
        "kind": { "$ref": "#/$defs/parameterKind" },
        "required": { "type": "boolean" },
        "default": { "$ref": "#/$defs/parameterValue" }
      }
    },
    "setting": {
      "type": "object",
      "required": ["key", "label", "kind", "required"],
      "properties": {
        "key": { "$ref": "#/$defs/camelKey" },
        "label": { "type": "string", "minLength": 1, "maxLength": 48 },
        "description": { "type": "string", "maxLength": 300 },
        "kind": { "$ref": "#/$defs/parameterKind" },
        "required": { "type": "boolean" },
        "default": { "$ref": "#/$defs/parameterValue" },
        "portability": {
          "enum": ["portable", "machineSpecific", "sensitive"],
          "default": "machineSpecific"
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label"],
      "properties": {
        "key": { "$ref": "#/$defs/camelKey" },
        "label": { "type": "string", "minLength": 1, "maxLength": 48 },
        "kind": {
          "enum": ["text", "integer", "boolean", "path", "url", "projectKey"],
          "default": "text"
        },
        "always": { "type": "boolean", "default": false },
        "sensitive": { "type": "boolean", "default": false }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "description": "NodeSpec without changesContext (plugins cannot change the active project).",
      "properties": {
        "version": { "type": "integer", "minimum": 1, "default": 1 },
        "icon": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
        "outputs": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/output" } },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 600000, "default": 30000 },
        "retrySafe": { "type": "boolean", "default": false },
        "idempotent": { "type": "boolean", "default": false },
        "cancellable": { "type": "boolean", "default": false },
        "effect": { "enum": ["readOnly", "opens", "modifies"], "default": "readOnly" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "category", "parameters"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 48 },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "category": { "type": "string", "minLength": 1, "maxLength": 32 },
        "parameters": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/parameter" }
        },
        "requiresProject": { "type": "boolean", "default": false },
        "deprecated": { "type": "boolean", "default": false },
        "replacedBy": { "$ref": "#/$defs/localId" },
        "node": { "$ref": "#/$defs/node" },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["refresh", "intervalSeconds"],
          "properties": {
            "refresh": { "enum": ["onEvents", "every"] },
            "intervalSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
          }
        },
        "device": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "requires": { "$ref": "#/$defs/deviceFamilies" } }
        }
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "valueType", "scope"],
      "properties": {
        "id": { "$ref": "#/$defs/variablePath" },
        "name": { "type": "string", "minLength": 1, "maxLength": 48 },
        "description": { "type": "string", "maxLength": 300 },
        "valueType": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "enum": ["string", "integer", "boolean", "json"] } }
        },
        "scope": { "enum": ["machine", "profile", "project"] },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": { "const": "project" }
        },
        "sensitive": { "type": "boolean", "default": false },
        "deprecated": { "type": "boolean", "default": false }
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "hosts", "schemes"],
      "properties": {
        "key": { "$ref": "#/$defs/camelKey" },
        "label": { "type": "string", "minLength": 1, "maxLength": 48 },
        "description": { "type": "string", "maxLength": 300 },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/hostPattern" },
          "description": "Subset of the network permission's hosts. The secret is sent nowhere else."
        },
        "schemes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["bearer", "basic", "header", "query"] }
        },
        "headerName": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,64}$" },
        "queryName": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
        "setupUrl": { "$ref": "#/$defs/httpsUrl" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "schemes": { "type": "array", "contains": { "const": "header" } } }
          },
          "then": { "required": ["headerName"] }
        },
        {
          "if": {
            "properties": { "schemes": { "type": "array", "contains": { "const": "query" } } }
          },
          "then": { "required": ["queryName"] }
        }
      ]
    }
  }
}
