              "type": "text",
              "maxLength": 64
            }
          },
          {
            "key": "context",
            "label": "t:params.context.label",
            "description": "t:params.context.description",
            "required": false,
            "kind": {
              "type": "text",
              "maxLength": 128
            }
          },
          {
            "key": "removeOrphans",
            "label": "t:params.removeOrphans.label",
            "description": "t:params.removeOrphans.description",
            "required": false,
            "kind": {
              "type": "boolean"
            },
            "default": {
              "type": "boolean",
              "value": false
