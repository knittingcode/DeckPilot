          }
        ],
        "node": {
          "version": 1,
          "icon": "list-checks",
          "outputs": [
            {
              "key": "services",
              "label": "t:outputs.count",
              "kind": "integer",
              "always": true
            },
            {
              "key": "running",
              "label": "t:outputs.running",
              "kind": "integer",
              "always": true
            },
            {
              "key": "stopped",
              "label": "t:outputs.stopped",
              "kind": "integer",
              "always": true
            },
            {
              "key": "allRunning",
              "label": "t:outputs.allRunning",
              "kind": "boolean",
              "always": true
            },
            {
              "key": "containers",
              "label": "t:outputs.composeContainers",
              "kind": "text",
              "always": true
            },
            {
              "key": "project",
              "label": "t:outputs.project",
              "kind": "text",
              "always": false
            },
            {
              "key": "projectKey",
              "label": "t:outputs.projectKey",
              "kind": "projectKey",
              "always": false
            },
            {
              "key": "context",
              "label": "t:outputs.context",
              "kind": "text",
              "always": true
            }
          ],
          "timeoutMs": 30000,
          "retrySafe": true,
          "idempotent": true,
          "cancellable": true,
          "effect": "readOnly"
        },
        "state": {
          "refresh": "every",
          "intervalSeconds": 5
        }
      },
      {
        "id": "compose-up",
        "name": "t:actions.compose-up.name",
        "description": "t:actions.compose-up.description",
        "category": "t:category",
        "parameters": [
          {
            "key": "compose",
            "label": "t:params.compose.label",
