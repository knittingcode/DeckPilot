          }
        ],
        "node": {
          "version": 1,
          "icon": "server",
          "outputs": [
            {
              "key": "count",
              "label": "t:outputs.count",
              "kind": "integer",
              "always": true
            },
            {
              "key": "running",
              "label": "t:outputs.running",
              "kind": "integer",
              "always": true
            },
            {
              "key": "names",
              "label": "t:outputs.names",
              "kind": "text",
              "always": true
            },
            {
              "key": "containers",
              "label": "t:outputs.containers",
              "kind": "text",
              "always": true
            },
            {
              "key": "context",
              "label": "t:outputs.context",
              "kind": "text",
              "always": true
            }
          ],
          "timeoutMs": 30000,
          "retrySafe": true,
          "idempotent": true,
          "cancellable": true,
          "effect": "readOnly"
        },
        "state": {
          "refresh": "every",
          "intervalSeconds": 5
        }
      },
      {
        "id": "compose-status",
        "name": "t:actions.compose-status.name",
        "description": "t:actions.compose-status.description",
        "category": "t:category",
        "parameters": [
          {
            "key": "compose",
            "label": "t:params.compose.label",
            "description": "t:params.compose.description",
            "required": false,
            "kind": {
              "type": "resource",
              "kinds": [
                "directory",
