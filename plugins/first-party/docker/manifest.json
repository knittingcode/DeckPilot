{
  "$schema": "https://knittingcode.github.io/deckpilot-plugins/v1/schemas/plugin-manifest.schema.json",
  "manifestVersion": 1,
  "id": "deckpilot.docker",
  "name": "t:plugin.name",
  "version": "0.1.0",
  "publisher": {
    "id": "deckpilot",
    "name": "DeckPilot",
    "url": "https://github.com/knittingcode/deckpilot"
  },
  "description": "t:plugin.description",
  "repository": {
    "type": "git",
    "url": "https://github.com/knittingcode/deckpilot",
    "directory": "plugins/first-party/docker"
  },
  "license": "Apache-2.0",
  "keywords": [
    "docker",
    "compose",
    "containers",
    "logs"
  ],
  "categories": [
    "developer-tools"
  ],
  "engines": {
    "deckpilot": ">=0.9.0 <1.0.0",
    "pluginApi": "^1.9",
    "sdk": "0.1.0"
  },
  "runtime": {
    "kind": "wasm",
    "abi": 1
  },
  "entry": "src/lib.rs",
  "icons": {
    "128": "assets/icon-128.png"
  },
  "defaultLocale": "en",
  "locales": [
    "en",
    "pl"
  ],
  "dependencies": [
    {
      "id": "deckpilot.projects",
      "version": ">=0.1.0 <1.0.0",
      "optional": true,
      "justification": "t:dependencies.projects"
    }
  ],
  "permissions": [
    {
      "kind": "tools",
      "tools": [
        {
          "executable": "docker",
          "subcommands": [
            {
              "name": "context show"
            },
            {
              "name": "version",
              "options": [
                "--format"
              ]
            },
            {
              "name": "compose version",
              "options": [
                "--short"
              ]
            },
            {
              "name": "ps",
              "options": [
                "--no-trunc",
                "--format",
                "--all",
                "--filter"
              ]
            },
            {
              "name": "compose ps",
              "options": [
                "--format",
                "--all"
              ]
            },
            {
              "name": "compose logs",
              "options": [
                "--tail",
                "--since",
                "--no-color"
              ]
            },
            {
              "name": "logs",
              "options": [
                "--tail",
                "--since"
              ]
            },
            {
              "name": "compose up",
              "options": [
                "--detach"
              ]
            },
            {
              "name": "compose down",
              "options": [
                "--remove-orphans"
              ]
            },
            {
              "name": "compose restart"
            }
          ],
          "modify": true
        }
      ],
      "justification": "t:permissions.tools"
    },
    {
      "kind": "resources",
      "justification": "t:permissions.resources"
    },
    {
      "kind": "profile",
      "read": [
        "project"
      ],
      "justification": "t:permissions.profile"
    },
    {
      "kind": "device",
      "state": true,
      "justification": "t:permissions.device"
    }
  ],
  "contributes": {
    "actions": [
      {
        "id": "status",
        "name": "t:actions.status.name",
        "description": "t:actions.status.description",
        "category": "t:category",
        "parameters": [
          {
            "key": "context",
            "label": "t:params.context.label",
            "description": "t:params.context.description",
            "required": false,
            "kind": {
              "type": "text",
              "maxLength": 128
            }
          },
          {
            "key": "environment",
            "label": "t:params.environment.label",
            "description": "t:params.environment.description",
            "required": false,
            "kind": {
              "type": "resource",
              "kinds": [
                "dockerEnvironment",
                "directory"
              ]
            }
          }
        ],
        "node": {
          "version": 1,
          "icon": "container",
          "outputs": [
            {
              "key": "available",
              "label": "t:outputs.available",
              "kind": "boolean",
              "always": true
            },
            {
              "key": "reason",
              "label": "t:outputs.reason",
              "kind": "text",
              "always": false
            },
            {
              "key": "clientVersion",
              "label": "t:outputs.clientVersion",
              "kind": "text",
              "always": false
            },
            {
              "key": "serverVersion",
              "label": "t:outputs.serverVersion",
              "kind": "text",
              "always": false
            },
            {
              "key": "serverOs",
              "label": "t:outputs.serverOs",
              "kind": "text",
              "always": false
            },
            {
              "key": "composeVersion",
              "label": "t:outputs.composeVersion",
              "kind": "text",
              "always": false
            },
            {
              "key": "context",
              "label": "t:outputs.context",
              "kind": "text",
              "always": false
            }
          ],
          "timeoutMs": 60000,
          "retrySafe": true,
          "idempotent": true,
          "cancellable": true,
          "effect": "readOnly"
        },
        "state": {
          "refresh": "every",
          "intervalSeconds": 5
        }
      },
      {
        "id": "containers",
        "name": "t:actions.containers.name",
        "description": "t:actions.containers.description",
        "category": "t:category",
        "parameters": [
          {
            "key": "all",
            "label": "t:params.all.label",
            "description": "t:params.all.description",
            "required": false,
            "kind": {
              "type": "boolean"
            },
            "default": {
              "type": "boolean",
              "value": false
            }
          },
          {
            "key": "name",
            "label": "t:params.name.label",
            "description": "t:params.name.description",
            "required": false,
            "kind": {
              "type": "text",
              "maxLength": 128
            }
          },
          {
            "key": "context",
            "label": "t:params.context.label",
            "description": "t:params.context.description",
            "required": false,
            "kind": {
              "type": "text",
              "maxLength": 128
            }
          },
          {
            "key": "environment",
            "label": "t:params.environment.label",
            "description": "t:params.environment.description",
            "required": false,
            "kind": {
              "type": "resource",
              "kinds": [
                "dockerEnvironment",
                "directory"
              ]
