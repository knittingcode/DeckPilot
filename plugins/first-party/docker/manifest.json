        ],
        "node": {
          "version": 1,
          "icon": "play",
          "outputs": [
            {
              "key": "output",
              "label": "t:outputs.output",
              "kind": "text",
              "always": true,
              "sensitive": true
            },
            {
              "key": "project",
              "label": "t:outputs.project",
              "kind": "text",
              "always": false
            },
            {
              "key": "projectKey",
              "label": "t:outputs.projectKey",
              "kind": "projectKey",
              "always": false
            },
            {
              "key": "context",
              "label": "t:outputs.context",
              "kind": "text",
              "always": true
            }
          ],
          "timeoutMs": 600000,
          "retrySafe": true,
          "idempotent": true,
          "cancellable": true,
          "effect": "modifies"
