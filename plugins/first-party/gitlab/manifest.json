{
  "$schema": "https://knittingcode.github.io/deckpilot-plugins/v1/schemas/plugin-manifest.schema.json",
  "manifestVersion": 1,
  "id": "deckpilot.gitlab",
  "name": "GitLab",
  "version": "0.1.0",
  "publisher": {
    "id": "deckpilot",
    "name": "DeckPilot",
    "url": "https://github.com/knittingcode/deckpilot"
  },
  "description": "Merge requests, review requests, pipelines and projects from GitLab.com or a self-managed GitLab. Read-only.",
  "repository": {
    "type": "git",
    "url": "https://github.com/knittingcode/deckpilot",
    "directory": "plugins/first-party/gitlab"
  },
  "license": "Apache-2.0",
  "keywords": ["gitlab", "merge-requests", "pipelines", "reviews"],
  "categories": ["developer-tools"],
  "engines": { "deckpilot": ">=0.6.0 <1.0.0", "pluginApi": "^1.0", "sdk": "0.1.0" },
  "runtime": { "kind": "wasm", "abi": 1 },
  "entry": "src/lib.rs",
  "icons": { "128": "assets/icon-128.png" },
  "permissions": [
    {
      "kind": "network",
      "hosts": ["gitlab.com"],
      "methods": ["GET"],
      "userOrigins": [{ "setting": "apiUrl", "pathPrefix": true, "privateNetwork": true }],
      "justification": "Reads your user, projects, merge requests and pipelines from GitLab.com or the GitLab you enter. Only reads; never changes anything on GitLab."
    },
    {
      "kind": "credentials",
      "refs": ["token"],
      "justification": "Sends your GitLab token to gitlab.com or the GitLab you entered and allowed, and nowhere else, to read what the token may see."
    },
    {
      "kind": "openUrl",
      "hosts": ["gitlab.com"],
      "userOrigins": ["apiUrl"],
      "justification": "Opens a project, a merge request or another GitLab page in your browser when you run Open on GitLab."
    }
  ],
  "contributes": {
    "actions": [
      {
        "id": "current-user",
        "name": "Current GitLab user",
        "description": "The account the token belongs to; also checks that the token works.",
        "category": "GitLab",
        "parameters": [],
        "node": {
          "version": 1,
          "icon": "user",
          "outputs": [
            { "key": "username", "label": "Username", "kind": "text", "always": true },
            { "key": "name", "label": "Name", "kind": "text", "always": false },
            { "key": "url", "label": "Profile", "kind": "url", "always": true },
            {
              "key": "rateLimitRemaining",
              "label": "Requests left",
              "kind": "integer",
              "always": false
            }
          ],
          "timeoutMs": 130000,
          "retrySafe": true,
          "idempotent": true,
          "cancellable": true,
          "effect": "readOnly"
        }
      },
      {
        "id": "project",
        "name": "GitLab project",
        "description": "A project's default branch, visibility, counts and last activity.",
        "category": "GitLab",
        "parameters": [
          {
            "key": "project",
            "label": "Project",
            "description": "group/project (with subgroups), or the project's numeric id.",
            "required": true,
            "kind": { "type": "text", "maxLength": 1000 }
          }
        ],
        "node": {
          "version": 1,
          "icon": "book-open",
          "outputs": [
            { "key": "path", "label": "Project", "kind": "text", "always": true },
            {
              "key": "description",
              "label": "Description",
              "kind": "text",
              "always": false,
              "sensitive": true
            },
            { "key": "defaultBranch", "label": "Default branch", "kind": "text", "always": false },
            { "key": "visibility", "label": "Visibility", "kind": "text", "always": true },
            { "key": "archived", "label": "Archived", "kind": "boolean", "always": true },
            { "key": "openIssues", "label": "Open issues", "kind": "integer", "always": false },
            { "key": "stars", "label": "Stars", "kind": "integer", "always": true },
            { "key": "forks", "label": "Forks", "kind": "integer", "always": true },
            { "key": "url", "label": "Page", "kind": "url", "always": true },
            { "key": "lastActivityAt", "label": "Last activity", "kind": "text", "always": false }
          ],
          "timeoutMs": 130000,
          "retrySafe": true,
          "idempotent": true,
          "cancellable": true,
          "effect": "readOnly"
        }
      },
      {
        "id": "merge-requests",
        "name": "Open merge requests",
        "description": "Counts and lists open merge requests of a project, or yours across projects.",
        "category": "GitLab",
        "parameters": [
          {
            "key": "project",
            "label": "Project",
            "description": "group/project (with subgroups), or the project's numeric id. Empty: every project.",
            "required": false,
            "kind": { "type": "text", "maxLength": 1000 }
          },
          {
            "key": "filter",
            "label": "Which",
            "description": "all: every open merge request of the project; author-me: opened by you; review-requested: where you are a reviewer.",
            "required": false,
            "kind": { "type": "choice", "options": ["all", "author-me", "review-requested"] },
            "default": { "type": "choice", "value": "all" }
          },
          {
            "key": "limit",
            "label": "Listed",
            "description": "At most this many merge requests in the list.",
            "required": false,
            "kind": { "type": "integer", "min": 1, "max": 100 },
            "default": { "type": "integer", "value": 20 }
          }
        ],
        "node": {
          "version": 1,
          "icon": "git-branch",
          "outputs": [
            { "key": "count", "label": "Open merge requests", "kind": "integer", "always": true },
            { "key": "countExact", "label": "Count complete", "kind": "boolean", "always": true },
            { "key": "listed", "label": "Listed", "kind": "integer", "always": true },
            {
              "key": "items",
              "label": "Merge requests",
              "kind": "text",
              "always": true,
              "sensitive": true
            },
            { "key": "truncated", "label": "List truncated", "kind": "boolean", "always": true },
            { "key": "firstUrl", "label": "First merge request", "kind": "url", "always": false }
          ],
          "timeoutMs": 130000,
          "retrySafe": true,
          "idempotent": true,
          "cancellable": true,
          "effect": "readOnly"
        }
      },
      {
        "id": "review-requests",
        "name": "Review requests",
        "description": "Open merge requests where you are a reviewer, in every project or one.",
        "category": "GitLab",
        "parameters": [
          {
            "key": "project",
            "label": "Project",
            "description": "group/project (with subgroups), or the project's numeric id. Empty: every project.",
            "required": false,
            "kind": { "type": "text", "maxLength": 1000 }
          },
          {
            "key": "limit",
            "label": "Listed",
            "description": "At most this many merge requests in the list.",
            "required": false,
            "kind": { "type": "integer", "min": 1, "max": 100 },
            "default": { "type": "integer", "value": 20 }
          }
        ],
        "node": {
          "version": 1,
          "icon": "search",
          "outputs": [
            { "key": "count", "label": "Open merge requests", "kind": "integer", "always": true },
            { "key": "countExact", "label": "Count complete", "kind": "boolean", "always": true },
            { "key": "listed", "label": "Listed", "kind": "integer", "always": true },
            {
              "key": "items",
              "label": "Merge requests",
              "kind": "text",
              "always": true,
              "sensitive": true
            },
            { "key": "truncated", "label": "List truncated", "kind": "boolean", "always": true },
            { "key": "firstUrl", "label": "First merge request", "kind": "url", "always": false }
          ],
          "timeoutMs": 130000,
          "retrySafe": true,
          "idempotent": true,
          "cancellable": true,
          "effect": "readOnly"
        }
      },
      {
        "id": "pipeline",
        "name": "Pipeline status",
        "description": "The latest pipeline of a branch, tag or commit, or a merge request's head pipeline: overall ok, failing or pending, and job counts.",
        "category": "GitLab",
        "parameters": [
          {
            "key": "project",
            "label": "Project",
            "description": "group/project (with subgroups), or the project's numeric id.",
            "required": true,
            "kind": { "type": "text", "maxLength": 1000 }
          },
          {
            "key": "ref",
            "label": "Branch, tag or commit",
            "description": "Used when no merge request is given.",
            "required": false,
            "kind": { "type": "text", "maxLength": 250 }
          },
          {
            "key": "mergeRequest",
            "label": "Merge request",
            "description": "Its head pipeline is checked (the number after !).",
            "required": false,
            "kind": { "type": "integer", "min": 1 }
          }
        ],
        "node": {
          "version": 1,
          "icon": "list-checks",
          "outputs": [
            {
              "key": "state",
              "label": "State (ok, failing, pending, none)",
              "kind": "text",
              "always": true
            },
            { "key": "status", "label": "GitLab status", "kind": "text", "always": false },
            { "key": "pipelineId", "label": "Pipeline", "kind": "integer", "always": false },
            { "key": "sha", "label": "Commit", "kind": "text", "always": false },
            { "key": "total", "label": "Jobs", "kind": "integer", "always": true },
            { "key": "passed", "label": "Passed", "kind": "integer", "always": true },
            { "key": "failed", "label": "Failed", "kind": "integer", "always": true },
            { "key": "pending", "label": "Pending or running", "kind": "integer", "always": true },
            { "key": "skipped", "label": "Skipped or manual", "kind": "integer", "always": true },
            { "key": "failing", "label": "Failing jobs", "kind": "text", "always": true },
            { "key": "truncated", "label": "Not all read", "kind": "boolean", "always": true },
            { "key": "url", "label": "Page", "kind": "url", "always": false }
          ],
          "timeoutMs": 130000,
          "retrySafe": true,
          "idempotent": true,
          "cancellable": true,
          "effect": "readOnly"
        }
      },
      {
        "id": "open",
        "name": "Open on GitLab",
        "description": "Opens a project, a merge request or a GitLab page in the browser.",
        "category": "GitLab",
        "parameters": [
          {
            "key": "url",
            "label": "Page",
            "description": "An https page on the configured GitLab, e.g. a merge request's URL from an earlier node. Empty: the project below.",
            "required": false,
            "kind": { "type": "text", "maxLength": 2048 }
          },
          {
            "key": "project",
            "label": "Project",
            "description": "group/project (with subgroups), or the project's numeric id. Empty: every project.",
            "required": false,
            "kind": { "type": "text", "maxLength": 1000 }
          },
          {
            "key": "mergeRequest",
            "label": "Merge request",
            "description": "Opens this merge request of the project.",
            "required": false,
            "kind": { "type": "integer", "min": 1 }
          }
        ],
        "node": {
          "version": 1,
          "icon": "link",
          "outputs": [{ "key": "url", "label": "Opened", "kind": "url", "always": true }],
          "timeoutMs": 15000,
          "retrySafe": true,
          "idempotent": false,
          "cancellable": false,
          "effect": "opens"
        }
      }
    ],
    "settings": {
      "portabilityVersion": 1,
      "fields": [
        {
          "key": "apiUrl",
          "label": "API URL",
          "description": "https://gitlab.com/api/v4, or https://<host>/api/v4 for a self-managed GitLab. Only for this computer.",
          "required": true,
          "kind": { "type": "text", "maxLength": 512 },
          "default": { "type": "text", "value": "https://gitlab.com/api/v4" },
          "portability": "machineSpecific"
        },
        {
          "key": "timeoutSeconds",
          "label": "Time limit (s)",
          "description": "For all requests of one action.",
          "required": true,
          "kind": { "type": "integer", "min": 1, "max": 120 },
          "default": { "type": "integer", "value": 20 },
          "portability": "portable"
        }
      ]
    },
    "credentials": [
      {
        "key": "token",
        "label": "GitLab token",
        "description": "A GitLab token with read_api. Sent only to gitlab.com or the GitLab you entered and allowed, in the PRIVATE-TOKEN header.",
        "hosts": ["gitlab.com"],
        "userOrigin": "apiUrl",
        "schemes": ["header"],
        "headerName": "PRIVATE-TOKEN",
        "setupUrl": "https://gitlab.com/-/user_settings/personal_access_tokens"
      }
    ],
    "errorCodes": {
      "invalid-api-url": "The configured API URL is not an https address of a GitLab API.",
      "invalid-project": "The project is not group/project or a numeric id.",
      "invalid-ref": "The ref is not a branch, tag or commit name.",
      "unauthorized": "GitLab refused the token (401).",
      "forbidden": "The token may not read this (403), e.g. a missing scope.",
      "not-found": "Not found, or not visible with this token (404).",
      "rate-limited": "GitLab's rate limit is reached; the message says how long to wait.",
      "gitlab-error": "Another error status from GitLab.",
      "invalid-response": "The answer is not the JSON expected, or too large.",
      "url-not-allowed": "The page to open is not an https page on the configured GitLab.",
      "timed-out": "GitLab did not answer within the time limit of the settings."
    }
  }
}
