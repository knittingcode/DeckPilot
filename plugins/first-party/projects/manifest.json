{
  "$schema": "https://knittingcode.github.io/deckpilot-plugins/v1/schemas/plugin-manifest.schema.json",
  "manifestVersion": 1,
  "id": "deckpilot.projects",
  "name": "t:plugin.name",
  "version": "0.1.0",
  "publisher": {
    "id": "deckpilot",
    "name": "DeckPilot",
    "url": "https://github.com/knittingcode/deckpilot"
  },
  "description": "t:plugin.description",
  "repository": {
    "type": "git",
    "url": "https://github.com/knittingcode/deckpilot",
    "directory": "plugins/first-party/projects"
  },
  "license": "Apache-2.0",
  "keywords": ["projects", "context", "switcher"],
  "categories": ["productivity"],
  "engines": {
    "deckpilot": ">=0.10.0 <1.0.0",
    "pluginApi": "^1.9",
    "sdk": "0.1.0"
  },
  "runtime": {
    "kind": "wasm",
    "abi": 1
  },
  "entry": "src/lib.rs",
  "icons": {
    "128": "assets/icon-128.png"
  },
  "defaultLocale": "en",
  "locales": ["en", "pl"],
  "permissions": [
    {
      "kind": "projectContext",
      "select": true,
      "justification": "t:permissions.projectContext"
    },
    {
      "kind": "resources",
      "paths": true,
      "justification": "t:permissions.resources"
    },
    {
      "kind": "profile",
      "read": ["project"],
      "justification": "t:permissions.profile"
    },
    {
      "kind": "hostViews",
      "justification": "t:permissions.hostViews"
    }
  ],
  "contributes": {
    "actions": [
      {
        "id": "cycle",
        "name": "t:actions.cycle.name",
        "description": "t:actions.cycle.description",
        "category": "t:category",
        "parameters": [
          {
            "key": "direction",
            "label": "t:params.direction.label",
            "description": "t:params.direction.description",
            "required": false,
            "kind": {
              "type": "choice",
              "options": ["next", "previous"]
            },
            "default": {
              "type": "choice",
              "value": "next"
            }
          }
        ],
        "node": {
          "version": 1,
          "icon": "folder",
          "outputs": [
            {
              "key": "projectId",
              "label": "t:outputs.projectId",
              "kind": "text",
              "always": true
            },
            {
              "key": "projectKey",
              "label": "t:outputs.projectKey",
              "kind": "projectKey",
              "always": true
            },
            {
              "key": "projectName",
              "label": "t:outputs.projectName",
              "kind": "text",
              "always": true
            }
          ],
          "timeoutMs": 5000,
          "retrySafe": false,
          "idempotent": false,
          "cancellable": false,
          "effect": "modifies",
          "changesContext": true
        },
        "controls": {
          "key": ["click", "double-click", "long-press", "press", "release"],
          "encoder": ["click", "press", "rotate-clockwise", "rotate-counter-clockwise"]
        }
      },
      {
        "id": "select",
        "name": "t:actions.select.name",
        "description": "t:actions.select.description",
        "category": "t:category",
        "parameters": [
          {
            "key": "projectId",
            "label": "t:params.projectId.label",
            "description": "t:params.projectId.description",
            "required": false,
            "kind": {
              "type": "project"
            }
          }
        ],
        "node": {
          "version": 1,
          "icon": "folder",
          "outputs": [
            {
              "key": "projectId",
              "label": "t:outputs.projectId",
              "kind": "text",
              "always": true
            },
            {
              "key": "projectKey",
              "label": "t:outputs.projectKey",
              "kind": "projectKey",
              "always": true
            },
            {
              "key": "projectName",
              "label": "t:outputs.projectName",
              "kind": "text",
              "always": true
            }
          ],
          "timeoutMs": 5000,
          "retrySafe": true,
          "idempotent": true,
          "cancellable": false,
          "effect": "modifies",
          "changesContext": true
        }
      },
      {
        "id": "current",
        "name": "t:actions.current.name",
        "description": "t:actions.current.description",
        "category": "t:category",
