            },
            {
              "key": "projectKey",
              "label": "t:outputs.projectKey",
              "kind": "projectKey",
              "always": true
            },
            {
              "key": "projectName",
              "label": "t:outputs.projectName",
              "kind": "text",
              "always": true
            },
            {
              "key": "profileId",
              "label": "t:outputs.profileId",
              "kind": "text",
              "always": false
            }
          ],
          "timeoutMs": 5000,
          "retrySafe": true,
          "idempotent": true,
          "cancellable": false,
          "effect": "readOnly"
        }
      },
      {
        "id": "repository",
        "name": "t:actions.repository.name",
