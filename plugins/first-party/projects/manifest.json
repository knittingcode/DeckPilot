        "node": {
          "version": 1,
          "icon": "folder",
          "outputs": [
            {
              "key": "projectId",
              "label": "t:outputs.projectId",
              "kind": "text",
              "always": true
            },
            {
              "key": "projectKey",
              "label": "t:outputs.projectKey",
              "kind": "projectKey",
              "always": true
            },
            {
              "key": "projectName",
              "label": "t:outputs.projectName",
              "kind": "text",
              "always": true
            },
            {
              "key": "resource",
              "label": "t:outputs.resource",
              "kind": "text",
              "always": true
            },
            {
              "key": "resourceKey",
              "label": "t:outputs.resourceKey",
              "kind": "text",
              "always": true
            },
            {
              "key": "kind",
              "label": "t:outputs.kind",
              "kind": "text",
              "always": true
            },
            {
              "key": "value",
              "label": "t:outputs.value",
              "kind": "text",
              "always": true
            }
          ],
          "timeoutMs": 5000,
          "retrySafe": true,
          "idempotent": true,
          "cancellable": false,
          "effect": "readOnly"
        }
      },
      {
        "id": "documentation",
        "name": "t:actions.documentation.name",
        "description": "t:actions.documentation.description",
        "category": "t:category",
        "parameters": [
          {
            "key": "projectId",
            "label": "t:params.projectId.label",
            "description": "t:params.projectId.description",
            "required": false,
            "kind": {
              "type": "project"
            }
          }
        ],
        "node": {
          "version": 1,
          "icon": "folder",
          "outputs": [
            {
              "key": "projectId",
              "label": "t:outputs.projectId",
              "kind": "text",
              "always": true
            },
            {
              "key": "projectKey",
              "label": "t:outputs.projectKey",
              "kind": "projectKey",
              "always": true
            },
            {
              "key": "projectName",
              "label": "t:outputs.projectName",
              "kind": "text",
              "always": true
            },
            {
              "key": "resource",
              "label": "t:outputs.resource",
              "kind": "text",
              "always": true
            },
            {
              "key": "resourceKey",
              "label": "t:outputs.resourceKey",
              "kind": "text",
              "always": true
            },
            {
              "key": "kind",
              "label": "t:outputs.kind",
              "kind": "text",
              "always": true
            },
            {
              "key": "value",
              "label": "t:outputs.value",
