          "version": 1,
          "icon": "folder",
          "outputs": [
            {
              "key": "projectId",
              "label": "t:outputs.projectId",
              "kind": "text",
              "always": true
            },
            {
              "key": "projectKey",
              "label": "t:outputs.projectKey",
              "kind": "projectKey",
              "always": true
            },
            {
              "key": "projectName",
              "label": "t:outputs.projectName",
