      }
    ],
    "settings": {
      "portabilityVersion": 1,
      "fields": [
        {
          "key": "wrapAround",
          "label": "t:settings.wrapAround.label",
          "description": "t:settings.wrapAround.description",
          "required": true,
          "kind": {
            "type": "boolean"
          },
          "default": {
            "type": "boolean",
            "value": true
          },
          "portability": "portable"
        }
      ]
    },
    "variables": [
      {
        "id": "current.id",
        "name": "t:variables.id.name",
        "description": "t:variables.id.description",
        "valueType": {
          "type": "string"
        },
        "scope": "project",
        "requires": ["project"],
        "source": "host:project.id"
      },
      {
        "id": "current.key",
        "name": "t:variables.key.name",
        "description": "t:variables.key.description",
        "valueType": {
          "type": "string"
        },
        "scope": "project",
        "requires": ["project"],
        "source": "host:project.key"
      },
      {
        "id": "current.name",
        "name": "t:variables.name.name",
        "description": "t:variables.name.description",
        "valueType": {
          "type": "string"
        },
        "scope": "project",
        "requires": ["project"],
        "source": "host:project.name"
      }
    ],
    "navigation": [
      {
        "id": "projects",
        "label": "t:navigation.projects",
        "icon": "assets/icon-128.png",
        "view": "projects"
      }
    ],
    "views": [
      {
        "id": "projects",
        "kind": "projects",
        "context": "profile"
      }
    ],
    "statusItems": ["activeProject"],
    "dashboardCards": ["activeProject"],
    "errorCodes": {
      "no-projects": "t:errors.no-projects",
      "at-last-project": "t:errors.at-last-project",
      "at-first-project": "t:errors.at-first-project",
      "project-not-in-profile": "t:errors.project-not-in-profile",
      "projects-off": "t:errors.projects-off"
