          ],
          "timeoutMs": 5000,
          "retrySafe": false,
          "idempotent": false,
          "cancellable": false,
          "effect": "modifies",
          "changesContext": true
        },
        "controls": {
          "key": ["click", "double-click", "long-press", "press", "release"],
          "encoder": ["click", "press", "rotate-clockwise", "rotate-counter-clockwise"]
        },
        "deprecated": true,
